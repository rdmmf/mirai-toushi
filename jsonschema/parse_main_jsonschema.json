{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "parse_main",
  "description": "extract additional data from Mirai main.c/attack.c",
  "type": "object",
  "properties": {
    "script_name": {
      "description": "script name",
      "type": "string",
      "enum": ["parse_main.py"]
    },
    "ghidra_current_program": {
      "description": "Ghidra currentProgram info",
      "type": "object",
      "properties": {
        "name": {
          "description": "file name",
          "type": "string"
        },
        "path": {
          "description": "file path",
          "type": "string"
        },
        "sha256": {
          "description": "file SHA256 hash",
          "type": "string"
        },
        "language_id": {
          "description": "program language name",
          "type": "string"
        },
        "image_base": {
          "description": "program image base address",
          "type": "string"
        },
        "min_addr": {
          "description": "program minimum address",
          "type": "string"
        },
        "max_addr": {
          "description": "program maximum address",
          "type": "string"
        }
      }
    },
    "main_func": {
      "description": "Mirai main.c/main() info",
      "type": "object",
      "properties": {
        "name": {
          "description": "function name",
          "type": "string"
        },
        "entrypoint": {
          "description": "function entrypoint",
          "type": "string"
        },
        "how": {
          "description": "how main() was identified (heuristic / libc_start_main)",
          "type": "string"
        }
      }
    },
    "resolve_cnc_addr_func": {
      "description": "Mirai main.c/resolve_cnc_addr() info",
      "type": "object",
      "properties": {
        "name": {
          "description": "function name",
          "type": "string"
        },
        "entrypoint": {
          "description": "function entrypoint",
          "type": "string"
        },
        "cnc": {
          "description": "c2 domain/ip address",
          "type": "string"
        }
      }
    },
    "attack_init_func": {
      "description": "Mirai attack.c/attack_init() info",
      "type": "object",
      "properties": {
        "name": {
          "description": "function name",
          "type": "string"
        },
        "entrypoint": {
          "description": "function entrypoint",
          "type": "string"
        },
        "attacks_count": {
          "description": "number of attacks",
          "type": "number"
        },
        "attacks": {
          "description": "attack function using for DoS",
          "type": "array",
          "items": [
            {
              "type": "object",
              "properties": {
                "vector": {
                  "description": "attack vector defined at attack.h",
                  "type": "number"
                },
                "name": {
                  "description": "function name",
                  "type": "string"
                },
                "entrypoint": {
                  "description": "function entrypoint",
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "cnc_immediates": {
      "description": "c2 endpoints hardcoded as numeric immediates in a sockaddr_in setup, best first",
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "ip": {
              "description": "c2 ip address",
              "type": "string"
            },
            "port": {
              "description": "c2 port, null when sin_port is not a literal",
              "type": ["number", "null"]
            },
            "role": {
              "description": "cnc / resolver (dns) / bind (single instance port)",
              "type": "string"
            },
            "best": {
              "description": "the candidate reported as the c2",
              "type": "boolean"
            },
            "func": {
              "description": "function containing the sockaddr_in setup",
              "type": "string"
            },
            "addr": {
              "description": "address of the instruction writing sin_addr",
              "type": "string"
            },
            "raw_const": {
              "description": "the immediate as written in the code",
              "type": "string"
            },
            "byte_order": {
              "description": "memory (written directly) / wrapper (through htonl/htons)",
              "type": "string"
            },
            "sockaddr_addr": {
              "description": "address of the sockaddr_in, or a symbolic group when it is stack/gp relative",
              "type": "string"
            },
            "in_main": {
              "description": "the setup is in main() itself",
              "type": "boolean"
            },
            "has_connect": {
              "description": "the function also calls something with a (fd, ptr, 0x10) argument list",
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
